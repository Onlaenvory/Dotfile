/*****----- Configuration -----*****/
configuration {
    show-icons: true;
}


* {
  background: rgba(0, 0, 0, 0.6);
  fg: #cdd6f4;
  accent: #00000000;
  border-col: #313244;  
  background-color: @background;
  text-color: @fg;
  /* font: "  "; */
}

/*****----- Main Window -----*****/
window {
    transparency: "real";
    location: west;
    anchor: west;

    width: 335px;
    height: 60%;
    padding: 25px;
    border-radius: 0 30px 30px 0;   /* Top-Left Top-Right Bottom-Right Bottom-Left  */

    background-color: @background;
}

mainbox {
    enabled:            true;
    background-color:   transparent;
    children:           [ "listview" ];
}

listview {
  enabled: true;
  cycle: false;
  dynamic: true;
  scrollbar: false;
  
  layout: vertical;
  fixed-height: true;
  fixed-columns: true;
  /* columns: 1; */
  /* lines: 1; */

  padding: 3% 1% 2% 1%;
  spacing: 15px;
  background-color: transparent;
}

element {
    enabled:            true;
    spacing:            0px;
    margin:             0px;
    padding:            0px;
    border-radius:      15px;
    background-color:   transparent;
    cursor:             pointer;
    orientation:        vertical;
    

    width:              200px;
    height:             280px;
}

element-icon {
    size:               225px;
    expand:             true;
    horizontal-align:   0.5;
    vertical-align:     0.5;
    border-radius:      15px;
}

/* Add this to see which one you are hovering over */
element selected {
    background-color:   rgba(255, 255, 255, 0.3);
    border:             2px;
    border-color:       @accent;
}

element-text {
    enabled:            false;    /* Hide text so the image is the whole button */
}